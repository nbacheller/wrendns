# Keep the build context to sources only (target/ alone is several GiB).
target/
fuzz/target/
fuzz/corpus/
fuzz/artifacts/
bench/results/
bench/corpora/
bench/lists/
site/_site/
ui/node_modules/
ui/dist/
ui/.e2e/
ui/test-results/
ui/playwright-report/
.git/
**/*Zone.Identifier
**/__pycache__/

# REQ: OPS-004 - what the image workflow writes beside the sources (the OCI layout, the release
# binaries and their assets). In the context they changed `COPY . .`, so every later build step
# of the same run compiled all three platforms again.
/image.tar
/bin/
/dist/

# Git worktrees used for parallel work (each has its own node_modules and build output).
.wt/

# Local credentials for the Docker Desktop bundle: never in a build context.
deploy/docker-desktop/secrets/
