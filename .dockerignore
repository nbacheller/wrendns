# Keep the build context to sources only (target/ alone is several GiB).
target/
fuzz/target/
fuzz/corpus/
fuzz/artifacts/
bench/results/
bench/corpora/
bench/lists/
site/_site/
ui/node_modules/
ui/dist/
ui/.e2e/
ui/test-results/
ui/playwright-report/
.git/
**/*Zone.Identifier
**/__pycache__/

# Git worktrees used for parallel work (each has its own node_modules and build output).
.wt/

# Local credentials for the Docker Desktop bundle: never in a build context.
deploy/docker-desktop/secrets/
