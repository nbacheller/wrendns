# WrenDNS native service (REQ: OPS-004, spec/08 §4). Installed by deploy/systemd/install.sh.
[Unit]
Description=WrenDNS resolver
Documentation=https://github.com/nbacheller/wrendns/blob/main/docs/running.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=wrendns
Group=wrendns
ExecStart=/usr/local/bin/wrendns run -c /etc/wrendns/wrendns.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
# Graceful drain (OPS-007) gets time to finish.
TimeoutStopSec=30
# REQ: DSC-002 (T25.3, ADR-908) — a kernel OOM kill of a discovery worker (a child of this unit)
# must not stop the unit: DNS keeps answering, and the worker is restarted by the supervisor.
OOMPolicy=continue
Environment=WRENDNS_LOG=info
# REQ: OPS-004 (ADR-046) — how this node updates (self-update).
Environment=WRENDNS_INSTALL=native
# REQ: API-902 (T27.13, ADR-956 §4a) - this unit restarts the process on exit (Restart=on-failure), so the
# UI may offer "Restart now" (exit status 75). Nothing is guessed from the environment: a node run by
# hand has no supervisor.
Environment=WRENDNS_SUPERVISOR=systemd

# Port 53 without root: only this capability, nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Sandboxing: everything read-only except the data directory.
StateDirectory=wrendns
StateDirectoryMode=0750
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# Netlink is needed for the neighbor table (MAC addresses).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
UMask=0027

# A Pi-sized ceiling; raise it for very large blocklists.
MemoryMax=256M
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
