{
  "name": "wrendns-ui",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs",
    "brand": "node scripts/brand-css.mjs && node scripts/brand-assets.mjs",
    "check": "node scripts/check-quantifiers.mjs && node scripts/check-no-html.mjs && node scripts/brand-css.mjs --check && node scripts/brand-assets.mjs --check && node scripts/check-brand.mjs && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "types": "openapi-typescript ../docs/api/openapi.json -o src/lib/api-types.ts",
    "check:html": "node scripts/check-no-html.mjs",
    "check:help": "node scripts/check-help.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "uplot": "^1.6.32"
  }
}
